[
  {
    "name": "atm_begin",
    "description": "开始或接续会话并返回 brief。开工只调这一次，直接用返回的 brief；上下文压缩后改调无参的 atm_brief。在仓库里首次使用加 allow_project_create:true。resume 默认 auto：自动接上本 Agent 已退出的上一会话；要新会话传 resume:false。例：{agent_id:\"claude-code\", cwd:\"D:/repo\"} 必填：agent_id。 参数：agent_id≤128；project≤20；allow_project_create 默认 false；mode=auto|quick|project，默认 auto；role=PRIMARY|SUBAGENT|REVIEWER|OBSERVER，默认 PRIMARY；resume=true|false|auto，默认 auto；session≤128；predecessor_session_id≤128；parent_session_id≤128；title≤400；brief=none|minimal|full，默认 full；max_chars=400–5000，默认 1200；op_id≤128。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "allow_project_create": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "quick",
            "project"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "PRIMARY",
            "SUBAGENT",
            "REVIEWER",
            "OBSERVER"
          ]
        },
        "resume": {
          "enum": [
            true,
            false,
            "auto"
          ]
        },
        "session": {
          "type": "string"
        },
        "predecessor_session_id": {
          "type": "string"
        },
        "parent_session_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "signals": {
          "type": "object",
          "properties": {
            "expected_minutes": {
              "type": "integer"
            },
            "subtask_count": {
              "type": "integer"
            },
            "multi_session": {
              "type": "boolean"
