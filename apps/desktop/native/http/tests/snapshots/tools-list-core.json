  {
    "name": "atm_brief",
    "description": "重新取回 working set，参数全部可选（省略时按本连接的会话）。只在上下文压缩或长时间离开后调用。带 since_seq 时附带增量（取代 atm_delta）。 参数：project≤20；session≤128；task_key≤40；include 最多 11 项；include[]=objective|counts|own|next|records|current|handoff|progress|artifacts|task|delta；cursor≤4000；max_chars=300–5000，默认 1200。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "task_key": {
          "type": "string"
        },
        "since_seq": {
          "type": "integer"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "objective",
              "counts",
              "own",
              "next",
              "records",
              "current",
              "handoff",
              "progress",
              "artifacts",
              "task",
              "delta"
            ]
          }
        },
        "cursor": {
          "type": "string"
        },
        "max_chars": {
          "type": "integer"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "_meta": {
      "surface_version": "v6",
      "schema_hash": "5a022233884e0633"
    }
