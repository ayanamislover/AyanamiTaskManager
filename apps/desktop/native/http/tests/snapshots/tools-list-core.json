                  "SKIPPED"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "expected_checklist_version": {
                "type": "integer"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "blocked_reason": {
          "type": "string"
        },
        "waiting_for": {
          "type": "string"
        },
        "cancel_reason": {
          "type": "string"
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_key": {
          "type": [
            "string",
            "null"
          ]
        },
