    "@ayanami-task/errors": "workspace:*",
    "@ayanami-task/protocol": "workspace:*",
    "better-sqlite3": "13.0.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  }
}
