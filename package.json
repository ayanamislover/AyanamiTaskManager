{
  "name": "ayanami-task-manager",
  "productName": "AyanamiTaskManager",
  "version": "1.0.20",
  "description": "Local-first Windows project progress control plane for AI agents.",
  "author": "ayanami",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "apps/desktop/dist/main/main.cjs",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ayanami-task/desktop dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "test:unit": "vitest run packages/protocol packages/domain",
    "test:integration": "vitest run packages/storage-sqlite packages/application apps/daemon",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "electron .",
    "atm": "tsx packages/cli/src/bin.ts",
    "doctor": "tsx packages/cli/src/bin.ts doctor",
    "package": "pnpm build && tsx scripts/forge-package.ts",
    "make": "pnpm build && tsx scripts/forge-make.ts",
    "release": "tsx scripts/release.ts",
    "smoke:packaged": "tsx scripts/packaged-smoke.ts",
    "smoke:window": "tsx scripts/window-smoke.ts",
    "benchmark:blur-packaged": "tsx scripts/packaged-blur-benchmark.ts",
    "smoke:history": "tsx scripts/default-history-smoke.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "generate:mcp-contracts": "tsx scripts/generate-mcp-contracts.ts",
    "generate:operation-contracts": "tsx scripts/generate-operation-contracts.ts",
    "migrate:data-root": "tsx scripts/migrate-data-root.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/websocket": "11.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.101.4",
    "better-sqlite3": "13.0.2",
    "commander": "14.0.0",
    "fastify": "5.11.2",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/core": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.3.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "7.1.1",
    "vitest": "3.2.4"
  }
}
